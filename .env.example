# The native iOS music player can be built without these values.
# Copy this file to .env only when running the optional web/server features.

# Authentication
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Server
PORT=3000
DATABASE_URL=
MONGO_URL=
DB_NAME=

# Optional Forge integrations
# VITE_* values are embedded in the client bundle. Only use public or
# tightly restricted keys in variables with that prefix.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
